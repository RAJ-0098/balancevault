# Root-level environment example.
# Copy to .env and fill in real values.

# PostgreSQL connection string (Neon or local).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require
DATABASE_URL="postgresql://postgres:password@localhost:5432/balancevault?schema=public"

# Redis connection string.
REDIS_URL="redis://localhost:6379"

# JWT secrets — use long random strings in production.
JWT_SECRET="change-me-to-a-long-random-string"
JWT_REFRESH_SECRET="change-me-to-another-long-random-string"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Server
PORT=3001
CORS_ORIGIN="http://localhost:5173"

# Bcrypt cost factor (12 is a good default).
BCRYPT_ROUNDS=12

# Separate bootstrap connection (uses bootstrap_login role).
# Leave blank to skip the DB-level bootstrap path and use the HTTP endpoint instead.
BOOTSTRAP_DATABASE_URL=""
