# Backend environment.
# Copy to .env and fill in real values.

# PostgreSQL (Neon or local).
DATABASE_URL="postgresql://postgres:password@localhost:5432/balancevault?schema=public"

# Redis.
REDIS_URL="redis://localhost:6379"

# JWT.
JWT_SECRET="change-me-to-a-long-random-string"
JWT_REFRESH_SECRET="change-me-to-another-long-random-string"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Server.
PORT=3001
CORS_ORIGIN="http://localhost:5173"
NODE_ENV=development

# Bcrypt.
BCRYPT_ROUNDS=12

# Separate connection for DB-level first-admin bootstrap.
# Uses the bootstrap_login role. Leave blank to use the HTTP endpoint instead.
BOOTSTRAP_DATABASE_URL=""
